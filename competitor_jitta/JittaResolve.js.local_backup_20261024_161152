function cjEnabled_() {
  var raw = PropertiesService.getScriptProperties().getProperty(CJ_ENABLED_PROP_);
  if (raw == null || raw === '') return true;
  return String(raw).toLowerCase() !== 'false';
}

function cjCap_() {
  var n = parseInt(
    PropertiesService.getScriptProperties().getProperty(CJ_CAP_PROP_) || CJ_CAP_DEFAULT_,
    10
  );
  if (!(n > 0)) n = CJ_CAP_DEFAULT_;
  if (n > CJ_CAP_MAX_) n = CJ_CAP_MAX_;
  return n;
}

function cjIntervalMin_() {
  var n = parseInt(
    PropertiesService.getScriptProperties().getProperty(CJ_INTERVAL_MIN_PROP_) ||
      CJ_INTERVAL_MIN_DEFAULT_,
    10
  );
  // Apps Script everyMinutes: 1,5,10,15,30
  if (n <= 1) return 1;
  if (n <= 5) return 5;
  if (n <= 10) return 10;
  if (n <= 15) return 15;
  return 30;
}

function cjDailyCap_() {
  var n = parseInt(
    PropertiesService.getScriptProperties().getProperty(CJ_DAILY_CAP_PROP_) ||
      CJ_DAILY_CAP_DEFAULT_,
    10
  );
  if (!(n > 0)) n = CJ_DAILY_CAP_DEFAULT_;
  return n;
}

function cjYmd_() {
  return Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyy-MM-dd');
}

function cjDailyDone_() {
  var p = PropertiesService.getScriptProperties();
  var day = cjYmd_();
  if (String(p.getProperty(CJ_DAILY_DAY_PROP_) || '') !== day) {
    p.setProperty(CJ_DAILY_DAY_PROP_, day);
    p.setProperty(CJ_DAILY_DONE_PROP_, '0');
    return 0;
  }
  return Number(p.getProperty(CJ_DAILY_DONE_PROP_) || 0) || 0;
}

function cjDailyBump_(n) {
  n = Number(n) || 0;
  if (n <= 0) return;
  var p = PropertiesService.getScriptProperties();
  var day = cjYmd_();
  if (String(p.getProperty(CJ_DAILY_DAY_PROP_) || '') !== day) {
    p.setProperty(CJ_DAILY_DAY_PROP_, day);
    p.setProperty(CJ_DAILY_DONE_PROP_, String(n));
    return;
  }
  var cur = Number(p.getProperty(CJ_DAILY_DONE_PROP_) || 0) || 0;
  p.setProperty(CJ_DAILY_DONE_PROP_, String(cur + n));
}

function cjSs_() {
  return SpreadsheetApp.getActiveSpreadsheet();
}

function cjHeaderIndex_(hdr, name) {
  var i;
  for (i = 0; i < hdr.length; i++) {
    if (String(hdr[i] || '').trim() === name) return i;
  }
  return -1;
}

function cjCkIsTrue_(v) {
  if (v === true) return true;
  var s = String(v || '')
    .trim()
    .toUpperCase();
  return s === 'TRUE' || s === '1' || s === 'YES' || s === 'Y';
}

function cjEnsureLogSheet_() {
  var ss = cjSs_();
  var sh = ss.getSheetByName(CJ_LOG_SHEET_);
  if (!sh) {
    sh = ss.insertSheet(CJ_LOG_SHEET_);
    sh.getRange(1, 1, 1, 6).setValues([['at', 'runId', 'state', 'resolve', 'auto', 'detail']]);
  }
  return sh;
}

function cjAppendLog_(runId, state, resolveN, autoN, detail) {
  var sh = cjEnsureLogSheet_();
  sh.appendRow([
    new Date(),
    runId,
    state,
    resolveN != null ? resolveN : '',
    autoN != null ? autoN : '',
    String(detail || '').slice(0, 500),
  ]);
}

function cjEnsureCols_(sh, names) {
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idx = {};
  var i;
  for (i = 0; i < names.length; i++) {
    var c = names[i];
    var j = cjHeaderIndex_(hdr, c);
    if (j < 0) {
      lastCol++;
      sh.getRange(1, lastCol).setValue(c);
      hdr.push(c);
      j = lastCol - 1;
    }
    idx[c] = j;
  }
  return idx;
}

function cjEntryPreferred_(jitta) {
  if (jitta === CJ_JITTAI_BRAND_) return 'ブランド';
  if (jitta === CJ_JITTAI_MAKER_) return 'メーカー';
  if (jitta === CJ_JITTAI_EXCLUDE_) return '非仕入先';
  if (jitta === CJ_JITTAI_CHECK_) return '要確認';
  if (jitta === CJ_JITTAI_UNCHECKED_) return '未調査';
  return '未設定';
}

function cjRowUninvestigated_(row, hdr) {
  var idxConf = cjHeaderIndex_(hdr, '実態信頼度');
  if (idxConf >= 0 && String(row[idxConf] || '').trim()) return false;
  var idxJ = cjHeaderIndex_(hdr, '実態');
  var j = idxJ >= 0 ? String(row[idxJ] || '').trim() : '';
  if (!j || j === CJ_JITTAI_UNCHECKED_) return true;
  return j === CJ_JITTAI_CHECK_;
}

function cjHitEligible_(name) {
  if (!name || CJ_HIT_EXCLUDE_[name] || CJ_EXCLUDE_SEED_[name]) return false;
  return true;
}

/**
 * 法人格ゆれを除いた照合キー（モンテ物産＝モンテ物産(株)）。
 * 行の表示名は変えず、マスタ／サマリ突合と二重AI防止に使う。
 */
function cjNormalizeMakerKey_(name) {
  var s = String(name || '').trim();
  if (!s) return '';
  s = s.replace(/株式会社|有限会社|合同会社|合資会社|合名会社|一般社団法人|一般財団法人/g, '');
  s = s.replace(/[（(]株[）)]/g, '');
  s = s.replace(/[（(]有[）)]/g, '');
  s = s.replace(/㈱|㈲/g, '');
  s = s.replace(/\s+/g, '');
  return s;
}

/** 正名候補スコア（法人格なし・短い方を優先）。 */
function cjMakerCanonicalScore_(name) {
  var n = String(name || '').trim();
  var score = 1000 - n.length;
  if (/株式会社|[（(]株[）)]|㈱|有限会社|[（(]有[）)]|㈲|合同会社|合資会社|合名会社/.test(n)) {
    score -= 200;
  }
  return score;
}

function cjPickCanonicalMakerName_(names) {
  var best = '';
  var bestScore = -99999;
  var i;
  for (i = 0; i < (names || []).length; i++) {
    var n = String(names[i] || '').trim();
    if (!n) continue;
    var sc = cjMakerCanonicalScore_(n);
    if (!best || sc > bestScore) {
      best = n;
      bestScore = sc;
    }
  }
  return best;
}

function cjMasterCached_(master) {
  return !!(
    master &&
    String(master['実態候補'] || '').trim() &&
    String(master['実態信頼度'] || '').trim()
  );
}

function cjFindMakerRow_(sh, maker) {
  if (!sh || sh.getLastRow() < 2) return 0;
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idx = cjHeaderIndex_(hdr, 'メーカー');
  if (idx < 0) return 0;
  var vals = sh.getRange(2, 1, sh.getLastRow() - 1, lastCol).getValues();
  var r;
  for (r = 0; r < vals.length; r++) {
    if (String(vals[r][idx] || '').trim() === maker) return r + 2;
  }
  return 0;
}

/** 同一キーのサマリ行（表示名は維持）。 */
function cjFindMakerRowsByKey_(sh, maker) {
  var out = [];
  if (!sh || sh.getLastRow() < 2) return out;
  var key = cjNormalizeMakerKey_(maker);
  if (!key) return out;
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idx = cjHeaderIndex_(hdr, 'メーカー');
  if (idx < 0) return out;
  var vals = sh.getRange(2, 1, sh.getLastRow() - 1, lastCol).getValues();
  var r;
  for (r = 0; r < vals.length; r++) {
    var nm = String(vals[r][idx] || '').trim();
    if (!nm) continue;
    if (cjNormalizeMakerKey_(nm) === key) out.push({ sheetRow: r + 2, name: nm });
  }
  return out;
}

function cjLoadMaster_(maker) {
  var sh = cjSs_().getSheetByName(CJ_MASTER_SHEET_);
  if (!sh || sh.getLastRow() < 2) return null;
  var idxMap = cjEnsureCols_(sh, ['メーカー'].concat(CJ_MASTER_COLS_));
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var vals = sh.getRange(2, 1, sh.getLastRow() - 1, lastCol).getValues();
  var key = cjNormalizeMakerKey_(maker);
  var exact = null;
  var fuzzy = null;
  var r;
  for (r = 0; r < vals.length; r++) {
    var nm = String(vals[r][idxMap['メーカー']] || '').trim();
    if (!nm) continue;
    var row = { sheetRow: r + 2, メーカー: nm };
    var i;
    for (i = 0; i < CJ_MASTER_COLS_.length; i++) {
      var c = CJ_MASTER_COLS_[i];
      row[c] = vals[r][idxMap[c]];
    }
    if (nm === maker) {
      exact = row;
      break;
    }
    if (!fuzzy && key && cjNormalizeMakerKey_(nm) === key) fuzzy = row;
  }
  return exact || fuzzy;
}

function cjCanonicalMakerForUpsert_(maker) {
  maker = String(maker || '').trim();
  var loc = cjLoadMaster_(maker);
  if (loc && loc['メーカー']) return String(loc['メーカー']).trim();
  var sumSh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  var names = [];
  if (sumSh) {
    cjFindMakerRowsByKey_(sumSh, maker).forEach(function (x) {
      names.push(x.name);
    });
  }
  names.push(maker);
  var picked = cjPickCanonicalMakerName_(names);
  var key = cjNormalizeMakerKey_(maker);
  if (picked && cjNormalizeMakerKey_(picked) === key) return picked;
  return key || maker;
}

function cjUpsertMaster_(maker, patch) {
  var sh = cjSs_().getSheetByName(CJ_MASTER_SHEET_);
  if (!sh) throw new Error(CJ_MASTER_SHEET_ + ' が無い');
  var idxMap = cjEnsureCols_(sh, ['メーカー'].concat(CJ_MASTER_COLS_));
  var canon = cjCanonicalMakerForUpsert_(maker);
  var loc = cjLoadMaster_(maker);
  var sheetRow = loc ? loc.sheetRow : sh.getLastRow() + 1;
  if (!loc) sh.getRange(sheetRow, idxMap['メーカー'] + 1).setValue(canon);
  var c;
  for (c in patch) {
    if (!Object.prototype.hasOwnProperty.call(patch, c)) continue;
    if (idxMap[c] == null) continue;
    sh.getRange(sheetRow, idxMap[c] + 1).setValue(patch[c]);
  }
}

function cjPatchFromMaster_(master) {
  master = master || {};
  var patch = {};
  var i;
  for (i = 0; i < CJ_MASTER_COLS_.length; i++) {
    var c = CJ_MASTER_COLS_[i];
    if (master[c] != null && master[c] !== '') patch[c] = master[c];
  }
  return patch;
}

function cjSummaryAiConfirmed_(sh, sheetRow, hdr) {
  var idxConf = cjHeaderIndex_(hdr, '実態信頼度');
  if (idxConf < 0) return false;
  return String(sh.getRange(sheetRow, idxConf + 1).getValue() || '').trim() === 'high';
}

function cjNeedsResolve_(maker) {
  maker = String(maker || '').trim();
  if (!maker || !cjHitEligible_(maker)) return false;
  var master = cjLoadMaster_(maker);
  if (master && cjCkIsTrue_(master['実態再採取しない'])) return false;
  // マスタキャッシュがあっても、同一キーの未調査サマリは heal 対象（スキップしない）
  var sumSh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  if (!sumSh) return true;
  var row = cjFindMakerRow_(sumSh, maker);
  if (!row) return true;
  var hdr = sumSh.getRange(1, 1, 1, Math.max(sumSh.getLastColumn(), 1)).getValues()[0];
  if (cjSummaryAiConfirmed_(sumSh, row, hdr)) return false;
  return true;
}

function cjCollectTargets_() {
  var sh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  if (!sh || sh.getLastRow() < 2) return [];
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idxMaker = cjHeaderIndex_(hdr, 'メーカー');
  var idxHit = cjHeaderIndex_(hdr, CJ_HIT_COL_);
  if (idxMaker < 0) return [];
  var vals = sh.getRange(2, 1, sh.getLastRow() - 1, lastCol).getValues();
  var byKey = {};
  var r;
  for (r = 0; r < vals.length; r++) {
    var name = String(vals[r][idxMaker] || '').trim();
    if (!name || !cjHitEligible_(name)) continue;
    if (!cjRowUninvestigated_(vals[r], hdr)) continue;
    if (!cjNeedsResolve_(name)) continue;
    var hit = idxHit >= 0 ? Number(vals[r][idxHit]) || 0 : 0;
    var key = cjNormalizeMakerKey_(name) || name;
    var prev = byKey[key];
    if (
      !prev ||
      hit > prev.hit ||
      (hit === prev.hit && cjMakerCanonicalScore_(name) > cjMakerCanonicalScore_(prev.maker))
    ) {
      byKey[key] = { maker: name, hit: hit };
    }
  }
  var rows = [];
  var k;
  for (k in byKey) {
    if (Object.prototype.hasOwnProperty.call(byKey, k)) rows.push(byKey[k]);
  }
  rows.sort(function (a, b) {
    return b.hit - a.hit;
  });
  return rows.map(function (x) {
    return x.maker;
  });
}

function cjSplitPipe_(text) {
  return String(text || '')
    .split('|')
    .map(function (s) {
      return String(s || '').trim();
    })
    .filter(function (s) {
      return !!s;
    });
}

function cjJoinPipe_(arr) {
  var seen = {};
  var out = [];
  (arr || []).forEach(function (t) {
    t = String(t || '').trim();
    if (!t || seen[t]) return;
    seen[t] = true;
    out.push(t);
  });
  return out.join('|');
}

function cjNormalizeGyoshu_(resolved) {
  var raw = String((resolved && resolved.gyoshu) || '').trim();
  var src = String((resolved && resolved.gyoshu_source) || '').trim();
  if (raw) {
    if (
      (src === 'gemini' || src === 'openai' || src === 'product_inferred') &&
      raw.indexOf(CJ_GYOSHU_INFERRED_) < 0
    ) {
      return raw + CJ_GYOSHU_INFERRED_;
    }
    return raw;
  }
  if (src === 'none') return CJ_GYOSHU_UNKNOWN_;
  return '';
}

function cjNormalizeRoots_(text) {
  var allowed = {};
  CJ_AMAZON_ROOTS_.forEach(function (r) {
    allowed[r] = true;
  });
  var kept = [];
  cjSplitPipe_(text).forEach(function (v) {
    if (allowed[v]) kept.push(v);
  });
  return cjJoinPipe_(kept);
}

function cjEvidenceText_(urls) {
  if (typeof urls === 'string') return String(urls || '').trim();
  if (!urls || !urls.length) return '';
  return urls
    .map(function (u) {
      return String(u || '').trim();
    })
    .filter(Boolean)
    .join('|');
}

function cjNowFetched_() {
  return Utilities.formatDate(new Date(), 'Asia/Tokyo', "yyyy-MM-dd'T'HH:mm:ssXXX");
}

function cjToPatch_(resolved) {
  return {
    実態候補: String(resolved.jitta_candidate || '').trim(),
    実態信頼度: String(resolved.confidence || '').trim(),
    実態採取元: String(resolved.source || '').trim(),
    実態根拠URL: cjEvidenceText_(resolved.evidence_urls),
    実態取得日時: cjNowFetched_(),
    業種: cjNormalizeGyoshu_(resolved),
    Amazonルートカテゴリ: cjNormalizeRoots_(resolved.amazon_root_categories),
    AmazonBrowse棚: cjJoinPipe_(cjSplitPipe_(resolved.amazon_browse_shelves)),
    入口語候補: String(resolved.entry_needle || '').trim(),
    判定メモ: String(resolved.reason || '').trim().slice(0, 500),
  };
}

function cjShouldAuto_(curJitta, resolved) {
  if (String(curJitta || '').trim() === CJ_JITTAI_EXCLUDE_) return false;
  var cand = String((resolved && resolved.jitta_candidate) || '').trim();
  var conf = String((resolved && resolved.confidence) || '').trim();
  return conf === 'high' && cand && cand !== CJ_JITTAI_CHECK_;
}

function cjParseJson_(text) {
  var raw = String(text || '').trim();
  raw = raw.replace(/^```json\s*/i, '').replace(/^```\s*/i, '').replace(/```$/, '');
  var start = raw.indexOf('{');
  var end = raw.lastIndexOf('}');
  if (start < 0 || end <= start) return null;
  try {
    return JSON.parse(raw.slice(start, end + 1));
  } catch (e) {
    return null;
  }
}

function cjBuildPrompt_(maker) {
  return (
    'あなたは日本のEC仕入れ調査アシスタントです。メーカー「' +
    maker +
    '」について次を JSON 1オブジェクトのみで返してください。\n' +
    'キー: jitta_candidate, entry_preferred, entry_needle, confidence, source, evidence_urls, gyoshu, gyoshu_source, amazon_root_categories, amazon_browse_shelves, reason\n' +
    'jitta_candidate は次のいずれか: 製造メーカー / 入口ブランド / 要確認 / 非仕入先\n' +
    'entry_preferred: メーカー / ブランド / 要確認 / 非仕入先\n' +
    'confidence: high / medium / low\n' +
    'source: official / gemini / openai / 人手\n' +
    'evidence_urls: 根拠URLの配列\n' +
    'gyoshu: 一般的な業種。取れなければ空文字\n' +
    'gyoshu_source: official / gemini / openai / product_inferred / none\n' +
    'amazon_root_categories: Amazonルート（|区切り）。語彙は次のみ: ' +
    CJ_AMAZON_ROOTS_.join(' / ') +
    '\n' +
    'amazon_browse_shelves: Browse棚名（|区切り）\n' +
    '判断の芯: パッケージに載る名前は会社名か別ブランド名か。発売元商社でも自社製造なら製造メーカー。\n' +
    '説明文は不要。JSONのみ。'
  );
}

function cjGemini_(prompt) {
  var key = String(PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY') || '').trim();
  if (!key) return null;
  var model =
    String(PropertiesService.getScriptProperties().getProperty('CJ_GEMINI_MODEL') || '').trim() ||
    CJ_GEMINI_MODEL_;
  var url =
    'https://generativelanguage.googleapis.com/v1beta/models/' +
    model +
    ':generateContent?key=' +
    encodeURIComponent(key);
  var res = UrlFetchApp.fetch(url, {
    method: 'post',
    contentType: 'application/json',
    muteHttpExceptions: true,
    payload: JSON.stringify({
      contents: [{ parts: [{ text: String(prompt || '') }] }],
      generationConfig: { temperature: 0.2, maxOutputTokens: 2048 },
    }),
  });
  if (res.getResponseCode() !== 200) return null;
  var json = JSON.parse(res.getContentText());
  var cand = json.candidates && json.candidates[0];
  var parts = cand && cand.content && cand.content.parts ? cand.content.parts : [];
  var texts = [];
  var i;
  for (i = 0; i < parts.length; i++) {
    if (parts[i] && parts[i].text) texts.push(String(parts[i].text));
  }
  return texts.join('\n').trim() || null;
}

function cjOpenAi_(prompt) {
  var key = String(PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY') || '').trim();
  if (!key) return null;
  var model =
    String(PropertiesService.getScriptProperties().getProperty('CJ_OPENAI_MODEL') || '').trim() ||
    CJ_OPENAI_MODEL_;
  var res = UrlFetchApp.fetch('https://api.openai.com/v1/chat/completions', {
    method: 'post',
    contentType: 'application/json',
    muteHttpExceptions: true,
    headers: { Authorization: 'Bearer ' + key },
    payload: JSON.stringify({
      model: model,
      messages: [{ role: 'user', content: String(prompt || '') }],
      temperature: 0.2,
      max_completion_tokens: 600,
    }),
  });
  if (res.getResponseCode() !== 200) return null;
  var json = JSON.parse(res.getContentText());
  if (json.error) return null;
  return json.choices && json.choices[0] && json.choices[0].message
    ? String(json.choices[0].message.content || '').trim()
    : null;
}

function cjFetchAi_(maker) {
  var prompt = cjBuildPrompt_(maker);
  var parsed = cjParseJson_(cjGemini_(prompt));
  if (parsed) {
    parsed.source = parsed.source || 'gemini';
    return parsed;
  }
  parsed = cjParseJson_(cjOpenAi_(prompt));
  if (parsed) {
    parsed.source = parsed.source || 'openai';
    return parsed;
  }
  return CJ_FIXTURES_[maker] || null;
}

function cjApplyToSummaryRow_(sh, sheetRow, patch, resolved) {
  var mirrorIdx = cjEnsureCols_(sh, CJ_MIRROR_COLS_);
  var c;
  for (c in patch) {
    if (!Object.prototype.hasOwnProperty.call(patch, c)) continue;
    if (mirrorIdx[c] == null) continue;
    if (CJ_MIRROR_COLS_.indexOf(c) < 0) continue;
    sh.getRange(sheetRow, mirrorIdx[c] + 1).setValue(patch[c]);
  }
  ['実態採取元', '実態信頼度', '実態根拠URL', '業種', 'Amazonルートカテゴリ', 'AmazonBrowse棚'].forEach(
    function (col) {
      if (patch[col] != null && mirrorIdx[col] != null) {
        sh.getRange(sheetRow, mirrorIdx[col] + 1).setValue(patch[col]);
      }
    }
  );
  var hdr = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0];
  var idxJ = cjHeaderIndex_(hdr, '実態');
  var idxPref = cjHeaderIndex_(hdr, '入口推奨');
  var curJ = idxJ >= 0 ? String(sh.getRange(sheetRow, idxJ + 1).getValue() || '').trim() : '';
  var auto = cjShouldAuto_(curJ, resolved);
  var applied = curJ;
  if (auto && idxJ >= 0) {
    applied = String(resolved.jitta_candidate || '').trim();
    sh.getRange(sheetRow, idxJ + 1).setValue(applied);
    if (idxPref >= 0) {
      sh.getRange(sheetRow, idxPref + 1).setValue(
        String(resolved.entry_preferred || '').trim() || cjEntryPreferred_(applied)
      );
    }
  } else if (idxJ >= 0) {
    var cand = String(resolved.jitta_candidate || '').trim();
    var conf = String(resolved.confidence || patch['実態信頼度'] || '').trim();
    if (cand && conf && (!curJ || curJ === CJ_JITTAI_UNCHECKED_ || curJ === CJ_JITTAI_CHECK_)) {
      applied = cand;
      sh.getRange(sheetRow, idxJ + 1).setValue(cand);
      if (idxPref >= 0) {
        sh.getRange(sheetRow, idxPref + 1).setValue(
          String(resolved.entry_preferred || '').trim() || cjEntryPreferred_(cand)
        );
      }
    }
  }
  return { autoConfirm: auto, appliedJitta: applied };
}

function cjApplyToSummary_(maker, patch, resolved) {
  var sh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  if (!sh) throw new Error(CJ_SUM_SHEET_ + ' が無い');
  cjEnsureCols_(sh, CJ_MIRROR_COLS_);
  var rows = cjFindMakerRowsByKey_(sh, maker);
  if (!rows.length) {
    var sheetRow = sh.getLastRow() + 1;
    var idxMaker = cjHeaderIndex_(sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0], 'メーカー');
    if (idxMaker < 0) throw new Error('メーカー列が無い');
    sh.getRange(sheetRow, idxMaker + 1).setValue(maker);
    rows = [{ sheetRow: sheetRow, name: maker }];
  }
  var hdr = sh.getRange(1, 1, 1, Math.max(sh.getLastColumn(), 1)).getValues()[0];
  var last = { autoConfirm: false, appliedJitta: '', mirrored: 0 };
  var n = 0;
  var i;
  for (i = 0; i < rows.length; i++) {
    var rowVals = sh.getRange(rows[i].sheetRow, 1, rows[i].sheetRow, hdr.length).getValues()[0];
    // 既にミラー済みの別名行は上書きしない（入口推奨の破壊防止）
    if (!cjRowUninvestigated_(rowVals, hdr)) continue;
    last = cjApplyToSummaryRow_(sh, rows[i].sheetRow, patch, resolved);
    n++;
  }
  last.mirrored = n;
  return last;
}

function cjResolveOne_(maker) {
  maker = String(maker || '').trim();
  if (!maker) return { skipped: true };
  var sumSh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  var row = sumSh ? cjFindMakerRow_(sumSh, maker) : 0;
  if (row && sumSh) {
    var hdr = sumSh.getRange(1, 1, 1, Math.max(sumSh.getLastColumn(), 1)).getValues()[0];
    if (cjSummaryAiConfirmed_(sumSh, row, hdr)) return { skipped: true, reason: 'ai_confirmed' };
  }
  var master = cjLoadMaster_(maker);
  if (master && cjCkIsTrue_(master['実態再採取しない'])) {
    return { skipped: true, reason: 'no_resample' };
  }
  // マスタに同一キーのキャッシュがあれば AI せず全別名行へミラー
  if (cjMasterCached_(master)) {
    var cachedPatch = cjPatchFromMaster_(master);
    var cachedResolved = {
      jitta_candidate: String(master['実態候補'] || '').trim(),
      confidence: String(master['実態信頼度'] || '').trim(),
      entry_preferred: cjEntryPreferred_(String(master['実態候補'] || '').trim()),
    };
    var healed = cjApplyToSummary_(maker, cachedPatch, cachedResolved);
    Logger.log(
      '[競合実態AI] heal key=%s maker=%s cand=%s conf=%s rows=%s',
      cjNormalizeMakerKey_(maker),
      maker,
      cachedPatch['実態候補'],
      cachedPatch['実態信頼度'],
      healed.mirrored || 1
    );
    return {
      skipped: false,
      fromCache: true,
      autoConfirm: !!healed.autoConfirm,
      jitta: healed.appliedJitta,
    };
  }
  var promptMaker = cjCanonicalMakerForUpsert_(maker);
  var resolved = cjFetchAi_(promptMaker);
  if (!resolved) return { skipped: false, reason: 'no_resolve', autoConfirm: false };
  var patch = cjToPatch_(resolved);
  cjUpsertMaster_(maker, patch);
  var applied = cjApplyToSummary_(maker, patch, resolved);
  Logger.log(
    '[競合実態AI] maker=%s key=%s cand=%s conf=%s auto=%s rows=%s',
    maker,
    cjNormalizeMakerKey_(maker),
    patch['実態候補'],
    patch['実態信頼度'],
    applied.autoConfirm,
    applied.mirrored || 1
  );
  return {
    skipped: false,
    fromCache: false,
    autoConfirm: !!applied.autoConfirm,
    jitta: applied.appliedJitta,
  };
}

function cjResolveBatch_(cap, opt) {
  opt = opt || {};
  cap = cap != null ? cap : cjCap_();
  var aiLeft = opt.aiLeft != null ? opt.aiLeft : cap;
  var targets = cjCollectTargets_();
  var resolved = 0;
  var healed = 0;
  var skipped = 0;
  var autoN = 0;
  var i;
  for (i = 0; i < targets.length && resolved + healed < cap; i++) {
    var maker = targets[i];
    var masterPeek = cjLoadMaster_(maker);
    var willAi = !cjMasterCached_(masterPeek);
    if (willAi && resolved >= aiLeft) {
      skipped++;
      continue;
    }
    var res = cjResolveOne_(maker);
    if (res.skipped) {
      skipped++;
      continue;
    }
    if (res.fromCache) {
      healed++;
    } else {
      resolved++;
      if (res.autoConfirm) autoN++;
    }
  }
  return {
    resolved: resolved,
    healed: healed,
    skipped: skipped,
    autoN: autoN,
    cap: cap,
    pending: targets.length,
  };
}

/** トリガー／メニュー共通本体。 */
function cjRunResolveCore_(tag) {
  var runId = 'cj_' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd_HHmmss');
  if (!cjEnabled_()) {
    cjAppendLog_(runId, 'SKIP', 0, 0, 'CJ_ENABLED=false tag=' + tag);
    return { ok: false, detail: 'disabled' };
  }
  var done = cjDailyDone_();
  var dayCap = cjDailyCap_();
  var left = Math.max(0, dayCap - done);
  // 日次0でも heal（キャッシュ寄せ）は回す
  var cap = cjCap_();
  var batch = cjResolveBatch_(cap, { aiLeft: left });
  cjDailyBump_(batch.resolved);
  var detail =
    'resolve=' +
    batch.resolved +
    ' heal=' +
    (batch.healed || 0) +
    ' auto=' +
    batch.autoN +
    ' skip=' +
    batch.skipped +
    ' cap=' +
    batch.cap +
    ' pending=' +
    batch.pending +
    ' daily=' +
    (done + batch.resolved) +
    '/' +
    dayCap +
    ' tag=' +
    tag;
  cjAppendLog_(runId, 'DONE', batch.resolved, batch.autoN, detail);
  Logger.log('[競合実態AI] %s %s', runId, detail);
  return { ok: true, batch: batch, detail: detail };
}

