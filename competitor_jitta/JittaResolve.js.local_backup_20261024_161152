function cjHitEnabled_() {
  var raw = PropertiesService.getScriptProperties().getProperty(CJ_HIT_ENABLED_PROP_);
  if (raw == null || raw === '') return true;
  return String(raw).toLowerCase() !== 'false';
}

function cjHitIntervalMin_() {
  var n = parseInt(
    PropertiesService.getScriptProperties().getProperty(CJ_HIT_INTERVAL_MIN_PROP_) || '',
    10
  );
  if (!(n > 0)) return cjIntervalMin_();
  if (n <= 1) return 1;
  if (n <= 5) return 5;
  if (n <= 10) return 10;
  if (n <= 15) return 15;
  return 30;
}

function cjEnsureNamedCol_(sh, name) {
  if (!sh) return -1;
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idx = cjHeaderIndex_(hdr, name);
  if (idx >= 0) return idx;
  sh.getRange(1, lastCol + 1).setValue(name);
  return lastCol;
}

function cjMakersInCell_(cell) {
  var out = [];
  var parts = String(cell || '').split('|');
  var i;
  for (i = 0; i < parts.length; i++) {
    var p = String(parts[i] || '').trim();
    if (p) out.push(p);
  }
  return out;
}

/** 巡回日がある店数。同じ日の2店目も増える。途中スライスでは増えない。 */
function cjCountWalkN_(sellerSh) {
  if (!sellerSh || sellerSh.getLastRow() < 2) return 0;
  var lastCol = Math.max(sellerSh.getLastColumn(), 1);
  var hdr = sellerSh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idxWalk = cjHeaderIndex_(hdr, '巡回日');
  if (idxWalk < 0) return 0;
  var vals = sellerSh.getRange(2, idxWalk + 1, sellerSh.getLastRow() - 1, 1).getValues();
  var n = 0;
  var r;
  for (r = 0; r < vals.length; r++) {
    if (String(vals[r][0] || '').trim()) n++;
  }
  return n;
}

function cjNeedHitRecount_(sellerSh) {
  var last = PropertiesService.getScriptProperties().getProperty(CJ_HIT_LAST_WALK_N_PROP_);
  if (last == null || last === '') return true;
  return cjCountWalkN_(sellerSh) !== Number(last);
}

function cjHitTryLock_() {
  var p = PropertiesService.getScriptProperties();
  var until = Number(p.getProperty(CJ_HIT_LOCK_PROP_) || 0);
  var now = Date.now();
  if (until > now) return false;
  p.setProperty(CJ_HIT_LOCK_PROP_, String(now + CJ_HIT_LOCK_MS_));
  return true;
}

function cjHitUnlock_() {
  PropertiesService.getScriptProperties().deleteProperty(CJ_HIT_LOCK_PROP_);
}

/** 全店再走査。+1 加算はしない。 */
function cjRecomputeSellerHits_(sellerSh) {
  var hits = {};
  if (!sellerSh || sellerSh.getLastRow() < 2) return hits;
  var lastCol = Math.max(sellerSh.getLastColumn(), 1);
  var hdr = sellerSh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idxId = cjHeaderIndex_(hdr, 'sellerId');
  var idxExtract = cjHeaderIndex_(hdr, '抽出メーカー');
  if (idxId < 0 || idxExtract < 0) return hits;
  var vals = sellerSh.getRange(2, 1, sellerSh.getLastRow() - 1, lastCol).getValues();
  var r;
  for (r = 0; r < vals.length; r++) {
    var sid = String(vals[r][idxId] || '').trim();
    if (!sid) continue;
    var seenInShop = {};
    var makers = cjMakersInCell_(vals[r][idxExtract]);
    var mi;
    for (mi = 0; mi < makers.length; mi++) {
      var parent = makers[mi];
      if (!cjHitEligible_(parent)) continue;
      if (seenInShop[parent]) continue;
      seenInShop[parent] = true;
      hits[parent] = (hits[parent] || 0) + 1;
    }
  }
  return hits;
}

/** 既存サマリ行のセラーヒットだけ上書き（行追加しない）。 */
function cjSyncMakerSumHits_(hits) {
  hits = hits || {};
  var sh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  if (!sh || sh.getLastRow() < 2) return 0;
  var idxHit = cjEnsureNamedCol_(sh, CJ_HIT_COL_);
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idxMaker = cjHeaderIndex_(hdr, 'メーカー');
  if (idxMaker < 0 || idxHit < 0) throw new Error('メーカーサマリ列不足（メーカー/セラーヒット）');
  var n = sh.getLastRow() - 1;
  var makers = sh.getRange(2, idxMaker + 1, n, 1).getValues();
  var out = [];
  var hitMakers = 0;
  var i;
  for (i = 0; i < makers.length; i++) {
    var name = String(makers[i][0] || '').trim();
    var count = name && hits[name] != null ? hits[name] : 0;
    if (count > 0) hitMakers++;
    out.push([count]);
  }
  sh.getRange(2, idxHit + 1, n, 1).setValues(out);
  return hitMakers;
}

/** 小・中の門通過から店ごとの小規模出現。①候補は①スプシ。 */
function cjRecomputeSmallMakerHits_() {
  var makerBands = {};
  var mSh = cjSs_().getSheetByName(CJ_SUM_SHEET_);
  if (mSh && mSh.getLastRow() >= 2) {
    var mLast = Math.max(mSh.getLastColumn(), 1);
    var mHdr = mSh.getRange(1, 1, 1, mLast).getValues()[0];
    var idxM = cjHeaderIndex_(mHdr, 'メーカー');
    var idxB = cjHeaderIndex_(mHdr, '規模帯');
    if (idxM >= 0 && idxB >= 0) {
      var mVals = mSh.getRange(2, 1, mSh.getLastRow() - 1, mLast).getValues();
      var mr;
      for (mr = 0; mr < mVals.length; mr++) {
        var mk = String(mVals[mr][idxM] || '').trim();
        var band = String(mVals[mr][idxB] || '').trim();
        if (mk && band) makerBands[mk] = band;
      }
    }
  }
  var hits = {};
  try {
    var cSh = SpreadsheetApp.openById(CJ_RESEARCH_SS_).getSheetByName(CJ_CAND_SHEET_);
    if (cSh && cSh.getLastRow() >= 2) {
      var cLast = Math.max(cSh.getLastColumn(), 1);
      var cHdr = cSh.getRange(1, 1, 1, cLast).getValues()[0];
      var idxGate = cjHeaderIndex_(cHdr, '門結果');
      var idxMaker = cjHeaderIndex_(cHdr, 'メーカー');
      var idxSid = cjHeaderIndex_(cHdr, 'sellerId');
      var cVals = cSh.getRange(2, 1, cSh.getLastRow() - 1, cLast).getValues();
      var cr;
      for (cr = 0; cr < cVals.length; cr++) {
        if (String(cVals[cr][idxGate] || '') !== '通過') continue;
        var maker = idxMaker >= 0 ? String(cVals[cr][idxMaker] || '').trim() : '';
        var band = makerBands[maker] || '';
        if (band !== CJ_BAND_S_ && band !== CJ_BAND_M_) continue;
        var sid = idxSid >= 0 ? String(cVals[cr][idxSid] || '').trim() : '';
        if (!sid) continue;
        hits[sid] = (hits[sid] || 0) + 1;
      }
    }
  } catch (eC) {
    Logger.log(
      '[競合ヒット] small_hit skip ①候補 %s',
      String((eC && eC.message) || eC).slice(0, 120)
    );
    return 0;
  }
  var sh = cjSs_().getSheetByName(CJ_SELLER_SHEET_);
  if (!sh || sh.getLastRow() < 2) return 0;
  var idxHit = cjEnsureNamedCol_(sh, CJ_SMALL_HIT_COL_);
  var lastCol = Math.max(sh.getLastColumn(), 1);
  var hdr = sh.getRange(1, 1, 1, lastCol).getValues()[0];
  var idxId = cjHeaderIndex_(hdr, 'sellerId');
  if (idxId < 0 || idxHit < 0) return 0;
  var n = sh.getLastRow() - 1;
  var ids = sh.getRange(2, idxId + 1, n, 1).getValues();
  var old = sh.getRange(2, idxHit + 1, n, 1).getValues();
  var out = [];
  var updated = 0;
  var r;
  for (r = 0; r < ids.length; r++) {
    var sid2 = String(ids[r][0] || '').trim();
    var next = sid2 ? hits[sid2] || 0 : 0;
    out.push([next]);
    if (Number(old[r][0]) !== next) updated++;
  }
  sh.getRange(2, idxHit + 1, n, 1).setValues(out);
  return updated;
}

function cjRunHitCore_(tag) {
  var runId = 'cjh_' + Utilities.formatDate(new Date(), 'Asia/Tokyo', 'yyyyMMdd_HHmmss');
  if (!cjHitEnabled_()) {
    cjAppendLog_(runId, 'SKIP', 0, 0, 'hit CJ_HIT_ENABLED=false tag=' + tag);
    return { ok: false, detail: 'hit_disabled' };
  }
  var sellerSh = cjSs_().getSheetByName(CJ_SELLER_SHEET_);
  if (!sellerSh) {
    cjAppendLog_(runId, 'FAILED', 0, 0, 'hit no_seller tag=' + tag);
    return { ok: false, detail: 'no_seller' };
  }
  var walkN = cjCountWalkN_(sellerSh);
  if (tag !== 'menu' && !cjNeedHitRecount_(sellerSh)) {
    var skip = 'hit skip_same walkN=' + walkN + ' tag=' + tag;
    cjAppendLog_(runId, 'SKIP', 0, 0, skip);
    Logger.log('[競合ヒット] %s %s', runId, skip);
    return { ok: true, skipped: true, detail: skip };
  }
  if (!cjHitTryLock_()) {
    var busy = 'hit lock_busy tag=' + tag;
    cjAppendLog_(runId, 'SKIP', 0, 0, busy);
    return { ok: false, detail: busy };
  }
  try {
    var hits = cjRecomputeSellerHits_(sellerSh);
    var hitMakers = cjSyncMakerSumHits_(hits);
    var smallN = cjRecomputeSmallMakerHits_();
    PropertiesService.getScriptProperties().setProperty(CJ_HIT_LAST_WALK_N_PROP_, String(walkN));
    var detail =
      'hit_makers=' +
      hitMakers +
      ' small_upd=' +
      smallN +
      ' walkN=' +
      walkN +
      ' tag=' +
      tag;
    cjAppendLog_(runId, 'DONE', hitMakers, smallN, detail);
    Logger.log('[競合ヒット] %s %s', runId, detail);
    return { ok: true, hitMakers: hitMakers, smallN: smallN, detail: detail };
  } catch (e) {
    var msg = String((e && e.message) || e).slice(0, 160);
    cjAppendLog_(runId, 'FAILED', 0, 0, 'hit ' + msg);
    Logger.log('[競合ヒット] %s FAILED %s', runId, msg);
    return { ok: false, detail: msg };
  } finally {
    cjHitUnlock_();
  }
}

function cjRunHitFromTrigger() {
  cjRunHitCore_('trigger');
}

function cjMenuHitNow() {
  var r = cjRunHitCore_('menu');
  try {
    SpreadsheetApp.getUi().alert('ヒット数え直し', r.detail || JSON.stringify(r), SpreadsheetApp.getUi().ButtonSet.OK);
  } catch (e) {}
}

function cjCountHitTriggers_() {
  var n = 0;
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === CJ_HIT_TRIGGER_HANDLER_) n++;
  });
  return n;
}

function cjMenuDisarmHitTriggerQuiet_() {
  ScriptApp.getProjectTriggers().forEach(function (t) {
    if (t.getHandlerFunction() === CJ_HIT_TRIGGER_HANDLER_) ScriptApp.deleteTrigger(t);
  });
}

function cjMenuArmHitTrigger() {
  if (!cjHitEnabled_()) {
    SpreadsheetApp.getUi().alert('CJ_HIT_ENABLED=false のため開始できません');
    return;
  }
  cjMenuDisarmHitTriggerQuiet_();
  var every = cjHitIntervalMin_();
  ScriptApp.newTrigger(CJ_HIT_TRIGGER_HANDLER_).timeBased().everyMinutes(every).create();
  var msg =
    'ヒット時計開始 everyMin=' +
    every +
    '\n①側 Script Properties: PR_HIT_RECOUNT_OWNER=comp（省略でも委譲）';
  SpreadsheetApp.getUi().alert(msg);
  Logger.log('[競合ヒット] trigger armed %s', msg);
}

function cjMenuDisarmHitTrigger() {
  cjMenuDisarmHitTriggerQuiet_();
  SpreadsheetApp.getUi().alert(
    'ヒット時計を止めました。①側は PR_HIT_RECOUNT_OWNER=hb で名前取りのあと①が数え直せます。'
  );
  Logger.log('[競合ヒット] trigger disarmed n_left=%s', cjCountHitTriggers_());
}
